# Public listener. Docker maps this container port to the VM.
HOST=0.0.0.0
PORT=8080

# Aggregate, privacy-preserving counters. Docker persists /data in a named volume.
METRICS_FILE=/data/metrics.json

# Trust X-Forwarded-For only when the app is reachable exclusively through
# a trusted reverse proxy such as Caddy or nginx.
TRUST_PROXY=false

# Room lifecycle
HARD_TTL_MS=1800000
DISCONNECT_GRACE_MS=15000
HEARTBEAT_EVERY_MS=5000
HEARTBEAT_STALE_MS=12000
AUTH_TIMEOUT_MS=5000

# Abuse controls
MAX_WS_MESSAGE_BYTES=32768
MAX_RELAY_CHARS=24576
MAX_RELAYS_PER_WINDOW=30
RELAY_WINDOW_MS=10000
MAX_CREATES_PER_WINDOW=10
CREATE_WINDOW_MS=3600000
MAX_CONNECTIONS_PER_WINDOW=60
CONNECTION_WINDOW_MS=60000

# Optional comma-separated exact origins. Same-origin Host is always accepted.
ALLOWED_ORIGINS=
